<PlusConfiguration version="2.7">

  <DataCollection StartupDelaySec="1.0">
    <DeviceSet
      Name="PlusServer: Registration and Tracking"
      Description="Broadcasting through OpenIGTLink the tracking data necessary for Registration and Tracking from an Atracsys device."
    />
    <Device
      Id="TrackerDevice"
      Type="AtracsysTracker"
      MaxMissingFiducials="0"
      MaxMeanRegistrationErrorMm="1.0"
      SymmetriseCoordinates="1"
      EnableLasers="0"
      EnableIRstrobe="1"
      ImageCompressionThreshold="50"
      ImageIntegrationTime="130"
      ToolReferenceFrame="Tracker" >
      <DataSources>
        <DataSource Type="Tool" Id="Phantom" TrackingType="PASSIVE" GeometryFile="{PHANTOM}" />
        <DataSource Type="Tool" Id="Pointer" TrackingType="PASSIVE" GeometryFile="{TOOL}" />
      </DataSources>
      <OutputChannels>
        <OutputChannel Id="TrackerStream">
          <DataSource Type="Tool" Id="Phantom" />
          <DataSource Type="Tool" Id="Pointer" />
        </OutputChannel>
      </OutputChannels>
    </Device>
  </DataCollection>

  <PlusOpenIGTLinkServer
    MaxNumberOfIgtlMessagesToSend="100"
    MaxTimeSpentWithProcessingMs="50"
    ListeningPort="18944"
    SendValidTransformsOnly="TRUE"
    OutputChannelId="TrackerStream" >
    <DefaultClientInfo>
      <MessageTypes>
        <Message Type="TRANSFORM" />
      </MessageTypes>
      <TransformNames>
        <Transform Name="PointerToPhantom" />
        <Transform Name="PointerToTracker" />
        <Transform Name="PhantomToTracker" />
        <Transform Name="PhantomToPointer"/>
      </TransformNames>
    </DefaultClientInfo>
  </PlusOpenIGTLinkServer>

</PlusConfiguration>
